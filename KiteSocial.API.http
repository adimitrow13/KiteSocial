@KiteSocial.API_HostAddress = http://localhost:5067

### 1. Health Check
GET {{KiteSocial.API_HostAddress}}/api/health
Accept: application/json

### 2. Register User
# @name register
POST {{KiteSocial.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "rider@kitesocial.com",
  "username": "kiterider",
  "password": "Password123!",
  "fullName": "Alex Rider",
  "skillLevel": 2
}

### 3. Login
# @name login
POST {{KiteSocial.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "kiterider",
  "password": "Password123!"
}

### 4. Get Current User Profile (Requires Bearer token)
@authToken = {{login.response.body.token}}
GET {{KiteSocial.API_HostAddress}}/api/auth/me
Authorization: Bearer {{authToken}}
Accept: application/json
